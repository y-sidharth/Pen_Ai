# Pen AI - Google Cloud / Gemini env
# Copy to agent/.env and fill, or use Cloud setup in the Web UI sidebar.
# Never commit .env (gitignored).

# Option A: AI Studio (simplest, no GCP project)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_ai_studio_key_here
GEMINI_MODEL=gemini-2.5-pro

# Option B: Vertex AI (recommended for checklist - shows GCP usage)
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# GEMINI_MODEL=gemini-2.5-pro

# Optional Cloud Services
# FIRESTORE_COLLECTION=jarvis_conversations
# GCS_BUCKET=your-bucket-name


